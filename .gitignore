# Environment and credentials
.env*
*.pem
*.key
id_rsa*
id_ed25519*

# SQLite databases hold every stored API key. The real one lives under
# ~/.tubematic-data/, so any copy inside the checkout is a backup or a stray.
*.db
*.db-wal
*.db-shm

# Dependencies
node_modules/
*/node_modules/

# Build outputs
renderer/remotion/.cache/
renderer/remotion/public/bundle/

# Release tarballs built by scripts/build_release_tarball.py (TMDEV-91
# Phase 2) — regenerated on demand, not source.
dist/

# Pipeline data lives at ~/.tubematic-data/ (TMDEV-76), outside the checkout —
# nothing to ignore here any more. The old repo-relative mounted/ tree is
# ignored so an un-migrated checkout doesn't show it as untracked.
mounted/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
.superpowers/

# Git worktrees
.worktrees/

# Agent working directories — local machine config, not committed
.claude/*
.openclaw/

# `npx skills add` canonical install target (see kasm_workspace/ and onboard.py's
# `claude` step) — unlicensed third-party content, always installed fresh from
# source, never committed. A stray `skills add` run inside this repo previously
# left a stale copy here that was accidentally committed (TMDEV-39).
.agents/

# The other supported agent CLIs' project-scope config, written when one is
# run inside the checkout.
.opencode/
.codex/
opencode.json
opencode.jsonc

CLAUDE.md
AGENTS.md
agents.md
HANDOFF.md
HANDOFF.md.*

logs/*.log

# Onboard state — machine-specific, do not commit
.onboard-state.json

plan/*


code_review/*

docs/superpowers/*

# Maintainer-only release runbook — internal specifics (real commands, real
# failure recovery) that don't belong in the public docs/ tree. Never ships
# in the release tarball.
docs_private/

.pytest_cache/*
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/

# scripts/collect_diagnostics.py writes to ~ by default; `--out .` would land here.
tubematic-diagnostics-*/

dashboard/test-results/*
dashboard/playwright-report/*
dashboard/tests/e2e/.auth/

# Kasm image build scratch — regenerated by kasm_workspace/build.sh
kasm_workspace/build-context/

# VQA (TMDEV-68) — build scratch, plus artifacts generated at image-build
# time (vqa/seed/tubematic.db) and session runtime (bootstrap.sh's log) that
# vqa/build.sh's git-filtered staging must not pick up as "untracked but not
# ignored" and bake into the image.
vqa/build-context/
vqa/seed/
vqa/logs/

# Root-level QA scratch notes
/test_*.md
HANDOFF-archive.md
